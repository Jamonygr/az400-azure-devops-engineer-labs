{
  "schemaVersion": "2.0.0",
  "providerRegistration": "separately gated; never claimed by the local fixture",
  "ephemeral": true,
  "maxJobs": 1,
  "forkPullRequestsAllowed": false,
  "persistCredentials": false,
  "cleanupAfter": ["success", "failure", "cancellation"],
  "requiredEvidence": ["jobStatus", "workspaceRemoved", "credentialsInherited"],
  "githubInvocation": "./config.sh --ephemeral followed by ./run.sh",
  "azurePipelinesInvocation": "./run.sh --once"
}
