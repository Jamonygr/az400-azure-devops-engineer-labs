{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AZ400 validation outcome",
  "type": "object",
  "required": ["schemaVersion", "labId", "runId", "status", "checkpoints"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "labId": {"type": "string", "pattern": "^[0-2][0-9]$"},
    "runId": {"type": "string", "minLength": 3},
    "status": {"enum": ["passed", "failed", "partial"]},
    "verifiedAt": {"type": "string"},
    "checkpoints": {"type": "array", "minItems": 5, "maxItems": 5, "items": {
      "type": "object", "required": ["id", "status"], "additionalProperties": false,
      "properties": {"id": {"enum": ["CP1", "CP2", "CP3", "CP4", "CP5"]}, "status": {"enum": ["passed", "failed", "skipped"]}, "reason": {"type": "string"}}
    }}
  }
}
