{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AZ400 cleanup outcome",
  "type": "object",
  "required": ["schemaVersion", "labId", "runId", "status", "residual", "retained"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "labId": {"type": "string", "pattern": "^[0-2][0-9]$"},
    "runId": {"type": "string", "minLength": 3}, "status": {"enum": ["passed", "partial"]},
    "residual": {"type": "array", "items": {"type": "object", "required": ["kind", "name", "reason"]}},
    "retained": {"type": "array", "items": {"type": "string"}}
  }
}
